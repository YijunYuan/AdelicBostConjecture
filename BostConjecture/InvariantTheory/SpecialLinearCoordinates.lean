module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.FiniteType

/-!
# Coordinates of a pair of special linear groups

The coordinate algebra is the polynomial ring in the two matrices modulo
their determinant-minus-one equations. Its algebra-valued points are the
actual pair of Mathlib special linear matrix groups.
-/

@[expose] public section

noncomputable section

namespace BostConjecture.InvariantTheory

variable (K ι κ : Type*) [CommRing K] [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ]

/-- The determinant-one equation for the first matrix. -/
def specialLinearLeftRelation : MvPolynomial ((ι × ι) ⊕ (κ × κ)) K :=
  (Matrix.of fun i j : ι => MvPolynomial.X (Sum.inl (i, j))).det - 1

/-- The determinant-one equation for the second matrix. -/
def specialLinearRightRelation : MvPolynomial ((ι × ι) ⊕ (κ × κ)) K :=
  (Matrix.of fun i j : κ => MvPolynomial.X (Sum.inr (i, j))).det - 1

/-- The ideal generated by the two determinant-one equations. -/
def specialLinearPairIdeal : Ideal (MvPolynomial ((ι × ι) ⊕ (κ × κ)) K) :=
  Ideal.span {specialLinearLeftRelation K ι κ, specialLinearRightRelation K ι κ}

/-- The affine coordinate algebra of a pair of special linear groups. -/
abbrev SpecialLinearPairCoordinateRing :=
  MvPolynomial ((ι × ι) ⊕ (κ × κ)) K ⧸ specialLinearPairIdeal K ι κ

instance : Algebra.FiniteType K (SpecialLinearPairCoordinateRing K ι κ) :=
  Algebra.FiniteType.quotient K _

variable {K ι κ} {A : Type*} [CommRing A] [Algebra K A]

theorem specialLinearPairIdeal_le_ker
    (g : Matrix.SpecialLinearGroup ι A × Matrix.SpecialLinearGroup κ A) :
    specialLinearPairIdeal K ι κ ≤ RingHom.ker
      (MvPolynomial.aeval (Sum.elim (fun ij : ι × ι => g.1 ij.1 ij.2)
        (fun ij : κ × κ => g.2 ij.1 ij.2))).toRingHom := by
  let e : MvPolynomial ((ι × ι) ⊕ (κ × κ)) K →ₐ[K] A :=
    MvPolynomial.aeval (Sum.elim (fun ij : ι × ι => g.1 ij.1 ij.2) (fun ij : κ × κ => g.2 ij.1 ij.2))
  apply Ideal.span_le.mpr
  intro p hp
  rcases hp with rfl | ⟨rfl⟩
  · change e (specialLinearLeftRelation K ι κ) = 0
    rw [specialLinearLeftRelation, map_sub, map_one]
    change e.toRingHom _ - 1 = 0
    rw [RingHom.map_det]
    have h : e.toRingHom.mapMatrix (Matrix.of fun i j : ι =>
        (MvPolynomial.X (Sum.inl (i, j)) : MvPolynomial ((ι × ι) ⊕ (κ × κ)) K)) =
        (g.1 : Matrix ι ι A) := by
      ext i j
      simp [e]
    rw [h, g.1.property, sub_self]
  · change e (specialLinearRightRelation K ι κ) = 0
    rw [specialLinearRightRelation, map_sub, map_one]
    change e.toRingHom _ - 1 = 0
    rw [RingHom.map_det]
    have h : e.toRingHom.mapMatrix (Matrix.of fun i j : κ =>
        (MvPolynomial.X (Sum.inr (i, j)) : MvPolynomial ((ι × ι) ⊕ (κ × κ)) K)) =
        (g.2 : Matrix κ κ A) := by
      ext i j
      simp [e]
    rw [h, g.2.property, sub_self]

/-- Evaluation at an actual pair of determinant-one matrices, over any base algebra. -/
def specialLinearPairEval
    (g : Matrix.SpecialLinearGroup ι A × Matrix.SpecialLinearGroup κ A) :
    SpecialLinearPairCoordinateRing K ι κ →ₐ[K] A :=
  Ideal.Quotient.liftₐ _
    (MvPolynomial.aeval (Sum.elim (fun ij : ι × ι => g.1 ij.1 ij.2) (fun ij : κ × κ => g.2 ij.1 ij.2)))
    (fun _ hp => specialLinearPairIdeal_le_ker g hp)

@[simp]
theorem specialLinearPairEval_mk
    (g : Matrix.SpecialLinearGroup ι A × Matrix.SpecialLinearGroup κ A)
    (p : MvPolynomial ((ι × ι) ⊕ (κ × κ)) K) :
    specialLinearPairEval g (Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ) p) =
      MvPolynomial.aeval (Sum.elim (fun ij : ι × ι => g.1 ij.1 ij.2) (fun ij : κ × κ => g.2 ij.1 ij.2)) p :=
  rfl

theorem specialLinearPair_left_det
    (f : SpecialLinearPairCoordinateRing K ι κ →ₐ[K] A) :
    (Matrix.of fun i j : ι => f (Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ)
      (MvPolynomial.X (Sum.inl (i, j))))).det = 1 := by
  let q := Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ)
  have hz : q (specialLinearLeftRelation K ι κ) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have hf := congrArg f hz
  rw [map_zero] at hf
  have h : (f.comp q) (specialLinearLeftRelation K ι κ) = 0 := hf
  rw [specialLinearLeftRelation, map_sub, map_one] at h
  have hd := sub_eq_zero.mp h
  change (f.comp q).toRingHom _ = 1 at hd
  rw [RingHom.map_det] at hd
  exact hd

theorem specialLinearPair_right_det
    (f : SpecialLinearPairCoordinateRing K ι κ →ₐ[K] A) :
    (Matrix.of fun i j : κ => f (Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ)
      (MvPolynomial.X (Sum.inr (i, j))))).det = 1 := by
  let q := Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ)
  have hz : q (specialLinearRightRelation K ι κ) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have hf := congrArg f hz
  rw [map_zero] at hf
  have h : (f.comp q) (specialLinearRightRelation K ι κ) = 0 := hf
  rw [specialLinearRightRelation, map_sub, map_one] at h
  have hd := sub_eq_zero.mp h
  change (f.comp q).toRingHom _ = 1 at hd
  rw [RingHom.map_det] at hd
  exact hd

/-- A point of the coordinate algebra yields actual determinant-one matrices. -/
def specialLinearPairPoint
    (f : SpecialLinearPairCoordinateRing K ι κ →ₐ[K] A) :
    Matrix.SpecialLinearGroup ι A × Matrix.SpecialLinearGroup κ A :=
  (⟨Matrix.of (fun i j => f (Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ)
      (MvPolynomial.X (Sum.inl (i, j))))), specialLinearPair_left_det f⟩,
   ⟨Matrix.of (fun i j => f (Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ)
      (MvPolynomial.X (Sum.inr (i, j))))), specialLinearPair_right_det f⟩)

@[simp]
theorem specialLinearPairPoint_eval
    (g : Matrix.SpecialLinearGroup ι A × Matrix.SpecialLinearGroup κ A) :
    specialLinearPairPoint (specialLinearPairEval (K := K) g) = g := by
  apply Prod.ext
  · apply Subtype.ext
    ext i j
    exact MvPolynomial.aeval_X (R := K)
      (Sum.elim (fun ij : ι × ι => g.1 ij.1 ij.2) (fun ij : κ × κ => g.2 ij.1 ij.2)) (Sum.inl (i, j))
  · apply Subtype.ext
    ext i j
    exact MvPolynomial.aeval_X (R := K)
      (Sum.elim (fun ij : ι × ι => g.1 ij.1 ij.2) (fun ij : κ × κ => g.2 ij.1 ij.2)) (Sum.inr (i, j))

@[simp]
theorem specialLinearPairEval_point
    (f : SpecialLinearPairCoordinateRing K ι κ →ₐ[K] A) :
    specialLinearPairEval (specialLinearPairPoint f) = f := by
  have h : MvPolynomial.aeval (Sum.elim
      (fun ij => (specialLinearPairPoint f).1 ij.1 ij.2)
      (fun ij => (specialLinearPairPoint f).2 ij.1 ij.2)) =
      f.comp (Ideal.Quotient.mkₐ K (specialLinearPairIdeal K ι κ)) := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i <;> simp [specialLinearPairPoint]
  ext p
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective K (specialLinearPairIdeal K ι κ) p
  rw [specialLinearPairEval_mk]
  exact DFunLike.congr_fun h p

/-- The coordinate algebra represents pairs of special linear matrices over every algebra. -/
def specialLinearPairPointEquiv :
    (SpecialLinearPairCoordinateRing K ι κ →ₐ[K] A) ≃
      Matrix.SpecialLinearGroup ι A × Matrix.SpecialLinearGroup κ A where
  toFun := specialLinearPairPoint
  invFun := specialLinearPairEval
  left_inv := specialLinearPairEval_point
  right_inv := specialLinearPairPoint_eval

end BostConjecture.InvariantTheory
