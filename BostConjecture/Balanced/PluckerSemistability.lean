module

public import BostConjecture.Balanced.OrbitNorm
public import BostConjecture.InvariantTheory.Semistability
public import BostConjecture.InvariantTheory.Plucker.OrbitImage
public import BostConjecture.InvariantTheory.ComplexClosure.Comparison
public import BostConjecture.InvariantTheory.Plucker.OrbitCriterion
public import BostConjecture.Geometry.Determinant.Coordinates

/-!
# Geometric semistability of the actual balanced Plücker vector

The polynomial-image closure comparison converts the established orbit norm
bound into the canonical geometric semistability conclusion. The proved
compact averaging and invariant criterion then produce a positive-degree
homogeneous invariant nonzero on every nonzero vector of the actual Plücker line.
-/

@[expose] public section

noncomputable section

namespace BostConjecture.Balanced

open Module exteriorPower InvariantTheory
open scoped TensorProduct

variable {U W : Type*} [NormedAddCommGroup U] [InnerProductSpace ℂ U]
  [FiniteDimensional ℂ U] [NormedAddCommGroup W] [InnerProductSpace ℂ W]
  [FiniteDimensional ℂ W]

/-- The actual Plücker orbit has the same Euclidean and polynomial Zariski closures. -/
theorem closure_pluckerOrbit_eq_polynomialZariskiClosure (s : ℕ)
    (z : ⋀[ℂ]^s (U ⊗[ℂ] W)) :
    closure (Set.range fun g => pluckerRepresentation ℂ U W s g z) =
      polynomialZariskiClosure (K := ℂ)
        (Set.range fun g => pluckerRepresentation ℂ U W s g z) := by
  classical
  let : LinearOrder (Fin (Module.finrank ℂ U) × Fin (Module.finrank ℂ W)) :=
    LinearOrder.lift' (Fintype.equivFin _) (Fintype.equivFin _).injective
  let bU := Module.finBasis ℂ U
  let bW := Module.finBasis ℂ W
  have he := closure_polynomial_image_zeroLocus (E := ⋀[ℂ]^s (U ⊗[ℂ] W))
    ((bU.tensorProduct bW).exteriorPower s)
    (specialLinearPairIdeal ℂ (Fin (Module.finrank ℂ U)) (Fin (Module.finrank ℂ W)))
    (pluckerOrbitPolynomial bU bW s z)
  rwa [pluckerOrbit_polynomial_image bU bW s z] at he

/-- Balanced orthogonal projections give geometric semistability of their actual
Plücker vectors. The invariant-polynomial form of the criterion is proved separately. -/
theorem IsBalanced.isGeometricallySemistable_plucker {s : ℕ}
    {S : Submodule ℂ (U ⊗[ℂ] W)} (hS : IsBalanced S)
    (v : OrthonormalBasis (Fin s) ℂ S) :
    IsGeometricallySemistable (pluckerRepresentation ℂ U W s)
      (ιMulti ℂ s (fun i => (v i : U ⊗[ℂ] W))) := by
  change (0 : ⋀[ℂ]^s (U ⊗[ℂ] W)) ∉ polynomialZariskiClosure _
  rw [← closure_pluckerOrbit_eq_polynomialZariskiClosure]
  exact hS.zero_not_mem_closure_plucker_orbit v

/-- Every nonzero vector on the balanced Plücker line is geometrically semistable. -/
theorem IsBalanced.isGeometricallySemistable_plucker_line {s : ℕ}
    {S : Submodule ℂ (U ⊗[ℂ] W)} (hS : IsBalanced S)
    (v : OrthonormalBasis (Fin s) ℂ S) {z : ⋀[ℂ]^s (U ⊗[ℂ] W)}
    (hz : z ∈ Submodule.span ℂ {ιMulti ℂ s (fun i => (v i : U ⊗[ℂ] W))})
    (hz0 : z ≠ 0) : IsGeometricallySemistable (pluckerRepresentation ℂ U W s) z :=
  (hS.isGeometricallySemistable_plucker v).of_mem_span_singleton hz hz0

/-- A positive-rank tensor subspace forces both factors to have positive dimension. -/
theorem positive_factor_finranks_of_subspace_basis {s : ℕ}
    (S : Submodule ℂ (U ⊗[ℂ] W)) (v : Basis (Fin s) ℂ S) (hs : 0 < s) :
    0 < Module.finrank ℂ U ∧ 0 < Module.finrank ℂ W := by
  have hv : Module.finrank ℂ S = s := by simpa using Module.finrank_eq_card_basis v
  have hdim := Submodule.finrank_le S
  rw [hv, Module.finrank_tensorProduct] at hdim
  constructor <;> nlinarith

omit [FiniteDimensional ℂ U] [FiniteDimensional ℂ W] in
/-- The actual top-exterior image of a subspace is the line generated by any basis wedge. -/
theorem range_exteriorPower_subtype_eq_span_plucker {s : ℕ}
    (S : Submodule ℂ (U ⊗[ℂ] W)) (v : Basis (Fin s) ℂ S) :
    LinearMap.range (exteriorPower.map s S.subtype) =
      Submodule.span ℂ {ιMulti ℂ s (fun i => (v i : U ⊗[ℂ] W))} := by
  apply le_antisymm
  · rintro _ ⟨y, rfl⟩
    let e := Geometry.determinantCoordinates v
    have hy : y = e y • ιMulti ℂ s v := by
      simpa only [e, Geometry.determinantCoordinates_symm_apply] using
        (e.symm_apply_apply y).symm
    rw [hy, map_smul]
    apply Submodule.smul_mem
    apply Submodule.subset_span
    simp [Function.comp_def]
  · apply Submodule.span_le.mpr
    intro z hz
    obtain rfl := Set.mem_singleton_iff.mp hz
    exact ⟨ιMulti ℂ s v, by simp [Function.comp_def]⟩

/-- The homogeneous-invariant conclusion required by the main-theorem consumer. -/
theorem IsBalanced.exists_homogeneousInvariant_plucker {s : ℕ}
    {S : Submodule ℂ (U ⊗[ℂ] W)} (hS : IsBalanced S)
    (v : OrthonormalBasis (Fin s) ℂ S) (hs : 0 < s)
    {z : ⋀[ℂ]^s (U ⊗[ℂ] W)}
    (hz : z ∈ LinearMap.range (exteriorPower.map s S.subtype)) (hz0 : z ≠ 0) :
    ∃ d : ℕ, 0 < d ∧ ∃ p : homogeneousInvariants (pluckerRepresentation ℂ U W s) d,
      polynomialEval z (p : SymmetricAlgebra ℂ (Dual ℂ (⋀[ℂ]^s (U ⊗[ℂ] W)))) ≠ 0 := by
  classical
  obtain ⟨hU, hW⟩ := positive_factor_finranks_of_subspace_basis S v.toBasis hs
  let : LinearOrder (Fin (Module.finrank ℂ U) × Fin (Module.finrank ℂ W)) :=
    LinearOrder.lift' (Fintype.equivFin _) (Fintype.equivFin _).injective
  apply exists_homogeneousInvariant_of_plucker_semistable
    (Module.finBasis ℂ U) (Module.finBasis ℂ W) ⟨0, hU⟩ ⟨0, hW⟩ s
  apply hS.isGeometricallySemistable_plucker_line v _ hz0
  rwa [range_exteriorPower_subtype_eq_span_plucker S v.toBasis] at hz

/-- Manuscript Lemma 7.2, on the intrinsic top-exterior image of a nonzero subspace.
Every nonzero representative is geometrically semistable and is detected by an
actual positive-degree homogeneous special-linear invariant. -/
theorem IsBalanced.plucker_semistable {S : Submodule ℂ (U ⊗[ℂ] W)}
    (hS : IsBalanced S) (hS0 : S ≠ ⊥)
    {z : ⋀[ℂ]^(Module.finrank ℂ S) (U ⊗[ℂ] W)}
    (hz : z ∈ LinearMap.range (exteriorPower.map (Module.finrank ℂ S) S.subtype))
    (hz0 : z ≠ 0) :
    IsGeometricallySemistable (pluckerRepresentation ℂ U W (Module.finrank ℂ S)) z ∧
      ∃ d : ℕ, 0 < d ∧
        ∃ p : homogeneousInvariants (pluckerRepresentation ℂ U W (Module.finrank ℂ S)) d,
          polynomialEval z
            (p : SymmetricAlgebra ℂ (Dual ℂ (⋀[ℂ]^(Module.finrank ℂ S) (U ⊗[ℂ] W)))) ≠ 0 := by
  let v := stdOrthonormalBasis ℂ S
  let : Nontrivial S := Submodule.nontrivial_iff_ne_bot.mpr hS0
  have hs : 0 < Module.finrank ℂ S := Module.finrank_pos
  have hi := hS.exists_homogeneousInvariant_plucker v hs hz hz0
  refine ⟨?_, hi⟩
  obtain ⟨d, hd, p, hp⟩ := hi
  exact isGeometricallySemistable_of_homogeneousInvariant _ z (Nat.ne_of_gt hd) p.property hp

end BostConjecture.Balanced
